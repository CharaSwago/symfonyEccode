{% extends 'auth.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="flex items-center justify-center grow bg-center bg-no-repeat page-bg">
        <div class="card max-w-[370px] w-full">
            {{ form_start(registrationForm, {'attr': {'class': 'card-body flex flex-col gap-5 p-10'}}) }}
                <div class="text-center mb-2.5">
                    <h3 class="text-lg font-medium text-gray-900 leading-none mb-2.5">
                        Inscription
                    </h3>
                    <div class="flex items-center justify-center font-medium">
                        <span class="text-2sm text-gray-700 me-1.5">
                            Vous avez déjà un compte ?
                        </span>
                        <a class="text-2sm link" href="{{ path('auth.login') }}">
                            Me connecter
                        </a>
                    </div>
                </div>

                <div class="flex flex-col gap-1">
                    <label for="username" class="form-label font-normal text-gray-900">Nom d'utilisateur</label>
                    {{ form_widget(registrationForm.username, {'attr': {'class': 'input', 'placeholder': 'Nom d\'utilisateur'}}) }}
                </div>

                <div class="flex flex-col gap-1">
                    <label for="email" class="form-label font-normal text-gray-900">Email</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'input', 'placeholder': 'Adresse email'}}) }}
                </div>

                <div class="flex flex-col gap-1">
                    <label for="plainPassword" class="form-label font-normal text-gray-900">Mot de passe</label>
                    <div class="input" data-toggle-password="true">
                        {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder': 'Mot de passe'}}) }}
                        <button class="btn btn-icon" data-toggle-password-trigger="true" type="button">
                            <i class="ki-filled ki-eye text-gray-500 toggle-password-active:hidden"></i>
                            <i class="ki-filled ki-eye-slash text-gray-500 hidden toggle-password-active:block"></i>
                        </button>
                    </div>
                </div>

                <div class="flex flex-col gap-1">
                    <label for="plainPasswordConfirm" class="form-label font-normal text-gray-900">Confirmer le mot de passe</label>
                    <div class="input" data-toggle-password="true">
                        {{ form_widget(registrationForm.plainPasswordConfirm, {'attr': {'placeholder': 'Confirmer le mot de passe'}}) }}
                        <button class="btn btn-icon" data-toggle-password-trigger="true" type="button">
                            <i class="ki-filled ki-eye text-gray-500 toggle-password-active:hidden"></i>
                            <i class="ki-filled ki-eye-slash text-gray-500 hidden toggle-password-active:block"></i>
                        </button>
                    </div>
                </div>

                <label class="checkbox-group">
                    <span class="checkbox-label">
                        J'accepte les <a class="text-2sm link" href="#">GCU</a>
                    </span>
                </label>

                <button type="submit" class="btn btn-primary flex justify-center grow">Inscription</button>
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
