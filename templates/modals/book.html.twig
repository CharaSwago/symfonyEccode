<div class="modal" data-modal="true" id="book_modal">
    <div id="modalContent" class="modal-content max-w-[600px] top-[15%]">
        <div class="modal-header py-4 px-5">
            <h3 class="modal-title">Associer une description à un livre</h3>
        </div>
        <div class="modal-body p-0 pb-5">
            <div class="scrollable-y-auto" data-scrollable="true" data-scrollable-max-height="auto" data-scrollable-offset="300px">
                <!-- Formulaire -->
                <form id="updateDescriptionForm" action="{{ path('handle_description') }}" method="POST">
                    <div class="flex flex-col gap-5 p-5">
                        <!-- Sélection d'un livre -->
                        <div class="flex flex-col gap-1">
                            <label for="book" class="form-label font-normal text-gray-900">Livre</label>
                            <select id="book" name="book_id" class="select" required>
                                <option value="" disabled selected>Choisissez un livre</option>
                                {% for book in books %}
                                    <option value="{{ book.id }}">{{ book.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <!-- Champ de description -->
                        <div class="flex flex-col gap-1">
                            <label for="description" class="form-label font-normal text-gray-900">Description</label>
                            <textarea id="description" name="description" class="textarea"
                                placeholder="Ajoutez une description au livre..." required>  </textarea>
                        </div>

                        <!-- Bouton Enregistrer -->
                        <div class="flex justify-end">
                            <button type="submit" class="btn btn-primary">Associer la description</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>